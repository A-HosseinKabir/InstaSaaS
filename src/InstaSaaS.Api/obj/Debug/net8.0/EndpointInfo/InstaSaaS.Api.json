            "$ref": "#/components/schemas/InstaSaaS.Domain.TenantRole"
          }
        },
        "additionalProperties": false
      },
      "InstaSaaS.Api.SetActiveDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "InstaSaaS.Api.SwitchDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "InstaSaaS.Api.VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          }
